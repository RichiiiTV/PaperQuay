<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>4.5.10</Version>
    <Product>PaperQuay</Product>
    <Description>Local document scanning, OCR, and filing for Windows.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PaperQuay.Checks" />
    <PackageReference Include="NAPS2.Sdk" Version="1.6.1" />
    <PackageReference Include="NAPS2.Images.Gdi" Version="1.6.1" />
    <PackageReference Include="NAPS2.Sdk.Worker.Win32" Version="1.6.1" />
    <PackageReference Include="NAPS2.Pdfium.Binaries" Version="1.3.0" />
    <PackageReference Include="NAPS2.Tesseract.Binaries" Version="1.5.0" />
    <Content Include="tessdata\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckOcrModels" BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' And (!Exists('tessdata/deu.traineddata') Or !Exists('tessdata/eng.traineddata') Or !Exists('tessdata/osd.traineddata'))">
    <Error Text="OCR models are missing. From the repository root, run .\scripts\Get-OcrModels.ps1." />
  </Target>
</Project>
